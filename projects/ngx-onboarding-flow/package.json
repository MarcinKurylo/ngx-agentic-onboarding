{
  "name": "ngx-onboarding-flow",
  "version": "0.1.1",
  "description": "Config-driven, event-driven onboarding & product-tour engine for Angular. Define the whole tour in one typed object; the engine coordinates async transitions (business events, routing, DOM) and paints the overlay with Driver.js.",
  "keywords": [
    "angular",
    "onboarding",
    "product-tour",
    "guided-tour",
    "walkthrough",
    "user-onboarding",
    "tour",
    "driver.js",
    "signals",
    "event-driven"
  ],
  "author": "Marcin Kuryło <me@marcinkurylo.com>",
  "license": "MIT",
  "homepage": "https://github.com/MarcinKurylo/ngx-onboarding-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcinKurylo/ngx-onboarding-flow.git",
    "directory": "projects/ngx-onboarding-flow"
  },
  "bugs": {
    "url": "https://github.com/MarcinKurylo/ngx-onboarding-flow/issues"
  },
  "peerDependencies": {
    "@angular/common": ">=16.2.0 <23.0.0",
    "@angular/core": ">=16.2.0 <23.0.0",
    "@angular/router": ">=16.2.0 <23.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "dependencies": {
    "driver.js": "^1.8.0",
    "tslib": "^2.3.0"
  },
  "exports": {
    "./styles/theme.css": {
      "style": "./styles/theme.css",
      "default": "./styles/theme.css"
    }
  },
  "sideEffects": false
}
