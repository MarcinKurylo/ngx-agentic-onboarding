  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-agentic-onboarding",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-agentic-onboarding --watch --configuration development",
    "test": "ng test ngx-agentic-onboarding --watch=false",
    "test:coverage": "ng test ngx-agentic-onboarding --watch=false --code-coverage --karma-config karma.conf.js",
    "e2e": "playwright test",
