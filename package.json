{
  "name": "ngx-onboarding-flow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-onboarding-flow",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-onboarding-flow --watch --configuration development",
    "test": "ng test ngx-onboarding-flow --watch=false",
    "test:coverage": "ng test ngx-onboarding-flow --watch=false --code-coverage --karma-config karma.conf.js",
    "e2e": "playwright test",
    "lint": "ng lint",
    "docs": "typedoc",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "driver.js": "^1.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.1.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.3.0",
    "ng-packagr": "^22.1.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
